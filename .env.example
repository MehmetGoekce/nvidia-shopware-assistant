# NVIDIA NGC API Key (https://ngc.nvidia.com/ → API Key)
# Als NVIDIA Connect Member hast du Zugang zu Cloud Endpoints
NGC_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXX
LLM_API_KEY=${NGC_API_KEY}
EMBED_API_KEY=${NGC_API_KEY}
RAIL_API_KEY=${NGC_API_KEY}

# Cloud-Modus (kein GPU nötig)
CONFIG_OVERRIDE=config-build.yaml

# NIM Cache (nur für lokalen GPU-Modus)
LOCAL_NIM_CACHE=~/.cache/nim
